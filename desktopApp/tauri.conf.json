{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typewright",
  "version": "0.0.0",
  "identifier": "dev.bierdav.Typewright.Desktop",
  "build": { "devUrl": "http://localhost:5392", "frontendDist": "web" },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "label": "main", "create": false, "title": "Typewright", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 480, "dragDropEnabled": false }],
    "security": { "csp": null, "capabilities": [{ "identifier": "main", "windows": ["main"], "permissions": ["core:default"] }] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Write Typst with a live preview",
    "copyright": "Copyright © David Emanuel Bieregger",
    "icon": ["build/icons/32x32.png", "build/icons/128x128.png", "build/icons/256x256.png", "build/icon.icns", "build/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "linux": { "deb": { "depends": [] }, "rpm": { "release": "1" } }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["typewright-desktop"] } } }
}
